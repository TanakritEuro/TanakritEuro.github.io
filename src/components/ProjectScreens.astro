---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Project } from "../lib/resume";
import { labels } from "../lib/resume";

interface Props {
  images: NonNullable<Project["images"]>;
}

const { images } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.{png,jpg,jpeg,webp}", {
  eager: true,
});

const shots = images.map((img) => {
  const mod = files[`/src/assets/projects/${img.file}`];
  if (!mod) throw new Error(`Missing screenshot src/assets/projects/${img.file}`);
  return { ...img, src: mod.default };
});
---

<div class="screens no-print">
  <div class="grid">
    {
      shots.map((s, i) => (
        <figure>
          <a href={s.src.src}>
            <Image
              src={s.src}
              alt={s.alt}
              widths={[480, 800, 1280]}
              sizes="(min-width: 56rem) 22rem, (min-width: 40rem) 45vw, 92vw"
              loading={i === 0 ? "eager" : "lazy"}
            />
          </a>
          <figcaption>{s.caption}</figcaption>
        </figure>
      ))
    }
  </div>
  {labels.screenshotNote && <p class="note">{labels.screenshotNote}</p>}
</div>

<style>
  .screens {
    margin-block: 0.25rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  figure {
    margin: 0;
  }

  a {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    line-height: 0;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .note {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
