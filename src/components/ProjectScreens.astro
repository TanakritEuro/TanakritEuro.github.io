---
import { Image } from "astro:assets";
import type { Picture } from "../lib/resume";
import { image } from "../lib/images";

interface Props {
  images: Picture[];
  note?: string;
}

const { images, note } = Astro.props;
const shots = images.map((img) => ({ ...img, src: image("projects", img.file) }));
const single = shots.length === 1;
---

<div class:list={["screens", "no-print", { single }]}>
  <div class="grid">
    {
      shots.map((s) => (
        <figure>
          <a href={s.src.src}>
            <Image
              src={s.src}
              alt={s.alt}
              widths={single ? [640, 960, 1400] : [480, 800, 1280]}
              sizes={single ? "(min-width: 56rem) 38rem, 92vw" : "(min-width: 56rem) 22rem, (min-width: 40rem) 45vw, 92vw"}
              loading="lazy"
            />
          </a>
          {s.caption && <figcaption>{s.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
  {note && <p class="note">{note}</p>}
</div>

<style>
  .screens {
    margin-block: 0.25rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .screens:not(.single) .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A single figure (a chart) stays narrower than the Togethr pair. */
  .single {
    max-width: 38rem;
  }

  figure {
    margin: 0;
  }

  a {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    line-height: 0;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .note {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
