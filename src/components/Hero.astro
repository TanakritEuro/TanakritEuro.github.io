---
import { hasResumePdf, labels, resume } from "../lib/resume";

const [first, ...rest] = resume.name.split(" ");
const email = resume.contact.email;
---

<section class="hero" aria-labelledby="name">
  <h1 id="name">
    {first} <span class="nick">“{resume.nickname}”</span> {rest.join(" ")}
  </h1>
  <p class="headline">{resume.headline}<span class="sep" aria-hidden="true"> · </span><span class="loc">{resume.location}</span></p>

  <p class="availability"><span class="dot" aria-hidden="true"></span>{resume.availability}</p>

  <p class="summary">{resume.siteSummary ?? resume.summary}</p>

  <ul class="links">
    <li><a href={resume.contact.github}>{labels.github}</a></li>
    <li><a href={resume.contact.linkedin}>{labels.linkedin}</a></li>
    <li><a href={`mailto:${email}`}>{email}</a></li>
    {
      hasResumePdf && (
        <li class="no-print">
          <a class="button" href={resume.resumePdf} download>
            {labels.resumePdf}
          </a>
        </li>
      )
    }
  </ul>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem);
  }

  h1 {
    font-size: clamp(2.25rem, 1.4rem + 4vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .nick {
    font-weight: 400;
    font-style: normal;
    color: var(--muted);
  }

  .headline {
    margin-top: 0.9rem;
    font-size: 1.125rem;
    color: var(--muted);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .summary {
    margin-top: 1.25rem;
    max-width: var(--measure);
    font-size: 1.125rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .button {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .button:hover {
    background: var(--accent-soft);
  }

  @media (max-width: 30rem) {
    .sep {
      display: none;
    }

    .loc {
      display: block;
    }
  }

  @media print {
    .hero {
      padding: 0 0 0.6rem;
      max-width: none;
    }

    h1 {
      font-size: 20pt;
    }

    .headline,
    .summary {
      font-size: 10pt;
      margin-top: 0.3rem;
      max-width: none;
    }

    .availability {
      padding: 0;
      margin-top: 0.3rem;
      background: none;
      font-size: 10pt;
    }

    .dot {
      display: none;
    }

    .links {
      margin-top: 0.4rem;
      gap: 0.2rem 1.2rem;
    }
  }
</style>
